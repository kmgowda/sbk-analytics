# Canonical sbk-analytics launcher for Linux and macOS.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
OS_NAME=$(uname -s 2>/dev/null || true)

case "$OS_NAME" in
    Linux|Darwin)
        exec "$ROOT/sbk-analytics.sh" "$@"
        ;;
    *)
        printf '[sbk-analytics] ERROR: unsupported operating system: %s\n' \
            "${OS_NAME:-unknown}" >&2
        exit 1
        ;;
esac
