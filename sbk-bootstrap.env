# Canonical policy shared by the Bash and PowerShell bootstrap launchers.
# Keep these values simple key=value pairs; both launchers parse this file
# before an sbk-analytics Python environment is available.
SBK_ANALYTICS_MIN_PYTHON_MAJOR=3
SBK_ANALYTICS_MIN_PYTHON_MINOR=9
SBK_ANALYTICS_CONDA_PYTHON=3.10
SBK_ANALYTICS_VENV_FOLDER=.venv
SBK_ANALYTICS_CONDA_FOLDER=.conda
SBK_ANALYTICS_BOOTSTRAP_MARKER=.sbk-analytics-bootstrap
