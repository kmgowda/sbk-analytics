# SBK and sbk-charts release coordinates used by sbk-analytics.
#
# Each project is identified by a (URL, version) pair:
#   <project>.url     - GitHub repository URL (or 'owner/repo' shorthand)
#   <project>.version - release tag that must exist on that repository
# downloads.folder is the shared download/install cache for SBK and sbk-charts
# (default: ./.sbk). sbk.jdk.folder is the separate JDK cache (default: ./.jdk).
#
# Optional local packages take precedence over conda, the managed download
# cache, and the project URLs. Local folders must already be built/runnable;
# sbk-analytics never modifies them and never falls back to a download when an
# explicitly configured local folder is invalid. Relative paths are resolved
# relative to this file.
#
# Supported SBK local layouts:
#   <sbk.local.folder>/bin/sbk-yal
#   <sbk.local.folder>/build/install/sbk/bin/sbk-yal  (built source checkout)
# GEM workloads also require the matching sbk-gem-yal executable.
# Example:
# sbk.local.folder=/root/projects/SBK
#
# Supported sbk-charts local layouts:
#   <sbk-charts.local.folder>/sbk-charts              (source checkout)
#   <sbk-charts.local.folder>/bin/sbk-charts          (environment root)
# Example:
# sbk-charts.local.folder=/root/projects/sbk-charts
# If the command is elsewhere, set its exact path instead of a folder:
# sbk-charts.local.executable=/opt/sbk-charts/bin/sbk-charts
#
# Local versions are detected when the executable reports one. The policy can
# be "warn" (default), "exact" (fail on mismatch/unknown), or "ignore".
# sbk.version.policy=warn
# sbk-charts.version.policy=warn
#
# The supported SBK baseline launches Java via SBK_JAVA_HOME.
# sbk-analytics resolves a JDK whose major version matches `sbk.jdk.version`
# by probing (in order):
#   1. SBK_JAVA_HOME    (exported by the user) - highest priority
#   2. JAVA_HOME        (exported by the user)
#   3. `java` on PATH
#   4. Specified jdk folder (if jdk.folder is set in this file)
#   5. Download Temurin to specified folder (or cache if not specified)
# The chosen JDK home is then set as SBK_JAVA_HOME for every sbk-yal / sbk-gem-yal invocation.
# Note: JAVA_HOME is explicitly unset in the subprocess to prevent SBK from using
# a different Java version. Supported SBK releases use SBK_JAVA_HOME when set.
#
# SSL verification for downloads (GitHub API, files, pip/git installations):
#   ssl.verify=false is the shipped and code default.
#   ssl.verify=true enables certificate verification.
# To verify with a private CA, also set: ssl.ca.bundle=/path/to/company-ca.pem

sbk.url=https://github.com/kmgowda/SBK
# This pin establishes the SBK command and lifecycle baseline used by analytics.
# Runtime code assumes this contract instead of branching on version numbers.
sbk.version=10.6
# sbk.local.folder=/root/projects/SBK
downloads.folder=./.sbk
sbk.jdk.version=25
sbk.jdk.folder=./.jdk
ssl.verify=false
# ssl.ca.bundle=/path/to/company-ca.pem

sbk-charts.url=https://github.com/kmgowda/sbk-charts
sbk-charts.version=4.26.7.1
# SHA-256 of <url>/archive/refs/tags/<version>.tar.gz. When present,
# sbk-analytics verifies the source and does not require system Git.
sbk-charts.sha256=cdff5b8f94662b36d6d9c897d16b17565945cd5e6692672d9dc6d8d9d4a92b97
# sbk-charts.local.folder=/root/projects/sbk-charts
# sbk-charts.local.executable=/root/projects/sbk-charts/.venv/bin/sbk-charts
