# Canonical policy for the Linux/macOS Bash bootstrap launcher.
# Keep these values as simple key=value pairs because this file is sourced
# before an sbk-analytics Python environment is available.
# uv archive digests are verified before extraction. Update the version and all
# four supported platform digests together from the official uv release metadata.
SBK_ANALYTICS_PYTHON_VERSION=3.12.12
SBK_ANALYTICS_UV_VERSION=0.12.5
SBK_ANALYTICS_UV_LINUX_X86_64_SHA256=68a509da24b06b4223a1c0175fb5eb5bc79342b76cbeff0cfe51ac3f5b17b6b2
SBK_ANALYTICS_UV_LINUX_AARCH64_SHA256=9bf43b4d1a07665bf64d4c4e710930b382321a785e0eb10aac07f46471f86a31
SBK_ANALYTICS_UV_MACOS_X86_64_SHA256=b3b2137477cf96c9686ebfb71524614cec780c673fd73e59bce099aef02e70e8
SBK_ANALYTICS_UV_MACOS_AARCH64_SHA256=5bb0e5fe008a773c3dbcb97ff79cd89e1241464fe9d2f986d52ad8f1b037bd62
SBK_ANALYTICS_RUNTIME_FOLDER=sbk-analytics
SBK_ANALYTICS_BOOTSTRAP_MARKER=.sbk-analytics-bootstrap
