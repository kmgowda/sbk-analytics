# Canonical policy shared by the Bash and PowerShell bootstrap launchers.
# Keep these values simple key=value pairs; both launchers parse this file
# before an sbk-analytics Python environment is available.
# uv archive digests are verified before extraction. Update the version and all
# six platform digests together from the official uv release metadata.
SBK_ANALYTICS_PYTHON_VERSION=3.12.12
SBK_ANALYTICS_UV_VERSION=0.12.5
